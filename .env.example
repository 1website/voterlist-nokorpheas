# ==============================================================================
# NOKOR PHEAS VOTER MANAGEMENT SYSTEM - ENVIRONMENT VARIABLES
# ==============================================================================

# Environment Mode: 'development' or 'production'
ENVIRONMENT=production

# Application Secret Key for Session Signature (Generate a long random string)
# Example command to generate: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change_this_to_a_secure_random_string_32_bytes_or_more

# Password Salt for Hashing
SECRET_SALT=change_this_to_a_secure_random_salt_string

# Database URL (PostgreSQL recommended for Production on Railway/Supabase/Neon)
# Example: postgresql://postgres:password@db.xxxx.supabase.co:5432/postgres
# Leave empty to use local SQLite (voter_list.db) in development
DATABASE_URL=

# Seed Demo Voters: 'true' to seed 130+ demo voters, 'false' for empty clean system
SEED_DEMO_VOTERS=true

# Session Idle Timeout in seconds (Default: 900 = 15 minutes)
SESSION_TIMEOUT_SECONDS=900

